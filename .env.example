PORT=4000
# Neon Postgres (written by `neon env pull`)
# Pooled (-pooler host): app runtime
DATABASE_URL=""
# Direct: Prisma Migrate / Studio
DATABASE_URL_UNPOOLED=""

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Initial admin account (used by `npm run db:seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Frontend (CORS + on-demand revalidation)
FRONTEND_URL="http://localhost:3000"
REVALIDATE_SECRET="change-me-shared-with-frontend"

# Contact form email (SMTP). For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=your Gmail address, SMTP_PASS=a Google "App password" (not your normal password).
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
# Where contact messages are delivered (defaults to the site's public email)
MAIL_TO=""
